# cloudskraal-capex frontend — environment template.
# Copy to frontend/.env (gitignored) for local dev, or set at build time.

# Backend API base URL.
VITE_API_URL=http://localhost:3001/api

# Supabase auth. The anon (publishable) key is safe in client code — security is
# enforced by the API's JWT gate and Supabase RLS. Get these from the Supabase
# dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
