# cloudskraal-capex backend — environment template.
# Copy to backend/.env (gitignored) and fill in real values, OR set these in
# the host dashboard (e.g. Render) for production. dotenv loads backend/.env.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Comma-free single origin allowed in CORS in addition to the localhost defaults.
FRONTEND_URL=https://your-frontend.example.com
# Optional override for the SQLite file location (defaults to data/capex.db).
# CAPEX_DB_PATH=/absolute/path/to/capex.db

# ── Auth (Supabase JWT) ─────────────────────────────────────────────────────
# Required for the /api auth gate. Tokens are verified via supabase.auth.getUser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Set to "true" for local dev / the api test server to bypass the auth gate.
# Leave unset (or anything other than "true") in production to enforce auth.
AUTH_DISABLED=true

# ── Supabase (server-side, if used) ─────────────────────────────────────────
# service_role bypasses ALL row-level security — server-side only, never ship to
# the client.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# ── Turso / libSQL (if used) ────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Google Calendar integration (optional) ──────────────────────────────────
# Service-account JSON lives at backend/data/google-credentials.json (gitignored).
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CALENDAR_ROOIBOS=calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_SHEEP=calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_WINE=calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_GENERAL=calendar-id@group.calendar.google.com
